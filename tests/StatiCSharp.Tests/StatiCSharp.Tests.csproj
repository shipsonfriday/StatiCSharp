<Project Sdk="Microsoft.NET.Sdk">

  <!-- Framework and language version come from Directory.Build.props. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <!-- CA1707: test names use Method_Scenario_Expectation, which needs the underscores. -->
    <!-- CA1010: the custom elements in CustomElementTests inherit IEnumerable from
         HtmlElement, which is deliberate. Every theme defining its own element has to do
         the same, so this line also documents what a consumer needs. -->
    <NoWarn>$(NoWarn);CA1707;CA1010</NoWarn>
  </PropertyGroup>

  <!-- xunit.v3 runs on Microsoft Testing Platform and needs no separate runner packages. -->
  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/StatiCSharp/StatiCSharp.csproj" />
  </ItemGroup>

</Project>
